FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /srv
RUN pip install --no-cache-dir fastapi uvicorn lightgbm shap pandas numpy
COPY 02_paypal_fraud/app ./02_paypal_fraud/app
COPY 02_paypal_fraud/results ./02_paypal_fraud/results
WORKDIR /srv/02_paypal_fraud
EXPOSE 8001
CMD ["uvicorn", "app.api:app", "--host", "0.0.0.0", "--port", "8001"]
